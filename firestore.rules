rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-all default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'thalwhdy8@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connectivity test
    match /test/{docId} {
      allow read: if true;
    }

    // Site settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Apps catalog
    match /apps/{appId} {
      allow get: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow list: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Allow public download counter increment
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'updatedAt']) &&
        request.resource.data.downloadCount == resource.data.downloadCount + 1
      );
    }

    // Advertisements slider
    match /ads/{adId} {
      allow get: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow list: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Social Links
    match /socialLinks/{linkId} {
      allow get: if (resource != null && resource.data.isEnabled == true) || isAdmin();
      allow list: if (resource != null && resource.data.isEnabled == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Service requests for web/app design
    match /serviceRequests/{requestId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isValidId(requestId) &&
        request.resource.data.keys().hasAll(['clientName', 'contactMethod', 'contactValue', 'projectType', 'projectDetails', 'status']) &&
        request.resource.data.clientName is string && request.resource.data.clientName.size() <= 100 &&
        request.resource.data.contactValue is string && request.resource.data.contactValue.size() <= 150 &&
        request.resource.data.projectDetails is string && request.resource.data.projectDetails.size() <= 3000;
    }
  }
}
